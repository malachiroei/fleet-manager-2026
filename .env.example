# PWA (vite-plugin-pwa): בפרויקט הטסט ב-Vercel הגדר autoUpdate; בפרויקט ייצור השאר ריק או prompt
# VITE_PWA_REGISTER_TYPE=autoUpdate

# ── Supabase (חובה) — העתק ל־`.env.local` (לא בקומיט); ב-Vercel הגדר לכל פרויקט.
# Vite חושף גם `VITE_*` וגם `NEXT_PUBLIC_*` (import.meta.env).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# אופציונלי: אימות ש-URL שייך ל-ref (מונע שימוש ב-URL של פרודקשן בסטייג׳)
# NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# NEXT_PUBLIC_SUPABASE_SKIP_PROJECT_REF_CHECK=1
# v2.7.65: ref פרודקשן — fallback בדומיין fleet-manager-pro כשאין PROJECT_REF
# NEXT_PUBLIC_FLEET_KNOWN_PRODUCTION_SUPABASE_REF=YOUR_PRODUCTION_PROJECT_REF
# v2.7.66: על fleet-manager-pro.com — URL ייצור (לפני NEXT_PUBLIC_SUPABASE_URL)
# NEXT_PUBLIC_FLEET_PRODUCTION_SUPABASE_URL=https://YOUR_PROD_REF.supabase.co
# NEXT_PUBLIC_FLEET_PRODUCTION_SUPABASE_ANON_KEY=eyJ...   (אופציונלי)
# או השאר NEXT_PUBLIC_SUPABASE_ANON_KEY של פרויקט הייצור ב-Vercel
# fallback ל-ref סטייג׳ כשאין NEXT_PUBLIC_SUPABASE_PROJECT_REF (למשל בפיתוח)
# NEXT_PUBLIC_FLEET_STAGING_DEFAULT_SUPABASE_REF=YOUR_STAGING_REF

# מפתח חלופי (אם נדרש בקוד ישן)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# אופציונלי (מקומי בלבד): Edge Function send-invite — service_role מ-Supabase Dashboard → Settings → API
# לא לפרסם ל-Vercel ציבורי. העתק ל־`.env.local`:
# VITE_SUPABASE_SERVICE_ROLE_KEY=your_secret_key_here
