# PWA (vite-plugin-pwa): בפרויקט הטסט ב-Vercel הגדר autoUpdate; בפרויקט ייצור השאר ריק או prompt
# VITE_PWA_REGISTER_TYPE=autoUpdate

# ── Supabase (חובה) — רק NEXT_PUBLIC_* בלקוח (בידוד: סטייג׳ ופרודקשן = פרויקטים וערכים שונים)
# העתק ל-.env המקומי; ב-Vercel הגדר Environment לכל פרויקט בנפרד.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# אופציונלי: אימות ש-URL שייך ל-ref (מונע שימוש ב-URL של פרודקשן בסטייג׳)
# NEXT_PUBLIC_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# NEXT_PUBLIC_SUPABASE_SKIP_PROJECT_REF_CHECK=1
# v2.7.65: ref פרודקשן (cesst…) — fallback בדומיין fleet-manager-pro כשאין PROJECT_REF
# NEXT_PUBLIC_FLEET_KNOWN_PRODUCTION_SUPABASE_REF=YOUR_PRODUCTION_PROJECT_REF
# v2.7.66: על fleet-manager-pro.com נטען URL Supabase ייצור קשיח; anon — אחד מהבאים:
# NEXT_PUBLIC_FLEET_PRODUCTION_SUPABASE_ANON_KEY=eyJ...   (אופציונלי)
# או השאר NEXT_PUBLIC_SUPABASE_ANON_KEY של פרויקט הייצור ב-Vercel

# מפתח חלופי (אם נדרש בקוד ישן)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
