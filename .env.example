# PWA (vite-plugin-pwa): בפרויקט הטסט ב-Vercel הגדר autoUpdate; בפרויקט ייצור השאר ריק או prompt
# VITE_PWA_REGISTER_TYPE=autoUpdate

# Supabase (use EITHER pair — Vite convention or Vercel/Next-style; both are read in production)
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
